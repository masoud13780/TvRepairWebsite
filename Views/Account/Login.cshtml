@model TvRepairWebsite.Models.ViewModels.LoginUserVM;

<head>
    <link href="~/css/Account.css" rel="stylesheet" />
    <style>
        header {
            display: none;
        }

        footer {
            display: none;
        }

        main {
            height: 100vh;
        }
    </style>
</head>
<div class="login-container">
    <h2>ورود به پنل کاربری</h2>
    @*در صورتی که در اینجا یوزر پسورد ادمین وارد شد باید ادمین بتونه وارد پنل کابری بشه *@    
    <form action="#" method="post">
        <div class="form-group">
            <input type="text" asp-for="Phone" required placeholder=" ">
            <label>شماره موبایل یا ایمیل</label>
            <span asp-validation-for="Phone"></span>
        </div>

        <div class="form-group">
            <input type="password" asp-for="Password" required placeholder=" ">
            <label>رمز عبور</label>
            <span asp-validation-for="Password"></span>
        </div>

        <button type="submit" class="login-btn">ورود</button>

        <div class="extra-links">
            <a asp-controller="Account" asp-action="Membership">ثبت نام</a>
            <a asp-controller="Account" asp-action="PasswordForgoten">رمز عبور را فراموش کرده‌اید؟</a>
        </div>
    </form>
</div>