@model TvRepairWebsite.Models.ViewModels.CreateUserVM;

<head>
    <link href="~/css/Account.css" rel="stylesheet" />
    <style>
        header {
            display: none;
        }

        footer {
            display: none;
        }

        main {
            height: 100vh;
        }
    </style>
</head>
<div class="register-container">
    <h2>عضویت</h2>

    <form asp-action="Membership" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row">
            <div class="form-group">
                <input type="text" asp-for= "FirstName" required placeholder=" ">
                <label>نام*</label>
                <span asp-validation-for="FirstName"></span>

            </div>

            <div class="form-group">
                <input type="text" asp-for="LastName" required placeholder=" ">
                <label>نام خانوادگی*</label>
                <span asp-validation-for="LastName"></span>

            </div>
        </div>

        <div class="form-group">
            <input type="tel" asp-for="Phone"  required placeholder=" ">
            <label>شماره موبایل*</label>
            <span asp-validation-for="Phone"></span>

        </div>

@*         <div class="form-group">
            <input type="email" placeholder=" ">
            <label>ایمیل*</label>
        </div> *@

        <div class="form-group">
            <input type="text" asp-for="TVType" placeholder=" ">
            <label>مدل تلویزیون (اختیاری)</label>
        </div>

        <div class="row">
            <div class="form-group">
                <input type="password" asp-for="Password" required placeholder=" ">
                <label>رمز عبور*</label>
                <span asp-validation-for="Password"></span>

            </div>

            <div class="form-group">
                <input type="password" asp-for="RePassword" required placeholder=" ">
                <label>تکرار رمز عبور*</label>
                <span asp-validation-for="RePassword"></span>

            </div>
        </div>

        <button type="submit" class="register-btn">ایجاد حساب کاربری</button>

        <div class="extra-links">
            <a asp-controller="Account" asp-action="Login">قبلاً ثبت‌نام کرده‌اید؟ ورود</a>
        </div>

    </form>
</div>