@model TvRepairWebsite.Models.ViewModels.HomeVM;
@{
    ViewData["Title"] = "تعمیر تلویزیون در مشهد";
    ViewData["Description"] =
        "تعمیر تخصصی تلویزیون ال جی، سامسونگ، سونی، آیوا، پاناسونیک، ایکس ویژن، تی سی ال، سام و انواع تلویزیون‌ها در مشهد";
}

<div class="banner diagonal-soft-bg">
    <div class="banner-text">
        <h1>تعمیر تخصصی تلویزیون در مشهد</h1>
        <h2>تیم مهندسی سلیمی</h2>
        <div class="divider"></div>
        <h3>
            ۳۵ سال تجربه در کنار تخصص و سرعت</h2>
            <h4>با استفاده از قطعات اورجینال، کیفیت تصویر را به تلویزیون شما برمی‌گردانیم.
        </h3>
        <a href="tel:+989154868011" class="Btn num-subs">
            تماس بگیرید!
        </a>
    </div>
    <div class="tv-img"></div>

</div>


<div class="subhero1">
    <h2>خدمات تیم مهندسی سلیمی </h2>
    <div class="experience-container">
        <div class="experience elevated">
            <i class="fa-solid fa-plug" style="color:brown"></i>
            <h4 style="color:brown">تعمیر تخصصی برد پاور</h4>
            <div class="divider"></div>
            <p style="color:brown">عیب‌یابی و تعمیر مشکلات روشن نشدن، خاموش شدن ناگهانی، نوسان تصویر و صدا ناشی از خرابی مدار تغذیه.</p>
        </div>
        <div class="experience elevated">
            <i class="fa-solid fa-microchip"></i>
            <h4 style="color:#1d0c75">تعمیر و پروگرام برد مین</h4>
            <div class="divider"></div>
            <p>رفع ایرادات هنگ کردن، نداشتن تصویر، نداشتن صدا، مشکل HDMI و پروگرام آی‌سی‌ها با دستگاه تخصصی.</p>

        </div>
        <div class="experience elevated">
            <i class="fa-solid fa-lightbulb" style="color:crimson"></i>
            <h4 style="color:crimson">تعمیر و تعویض بک‌لایت</h4>
            <div class="divider"></div>
            <p style="color:crimson">رفع مشکل سیاه شدن تصویر، کم‌نور شدن صفحه و لکه‌های نوری با استفاده از بک‌لایت اورجینال.</p>

        </div>
        <div class="experience elevated">
            <i class="fa-solid fa-tv" style="color:darkgoldenrod"></i>
            <h4 style="color:darkgoldenrod">تعمیر پنل و مشکلات تصویر</h4>
            <div class="divider"></div>
            <p style="color:darkgoldenrod">رفع خطوط عمودی و افقی، سایه افتادن تصویر، آب خوردگی، دو تصویر شدن و مشکلات T-Con.</p>

        </div>
        <div class="experience1 elevated">
            <img src="~/images/Rebal.png" alt="خدمات ریبال برد سی پی یو در مشهد" />
            <h4 style="color:#1d0c75">ریبال</h4>
            <div class="divider"></div>
            <p>ریبال تخصصی آی‌سی‌های BGA تلویزیون، رفع ایراد روشن نشدن و ریست شدن دستگاه، بازسازی اتصالات آسیب‌دیده برد مین، تعمیر مشکلات ناشی از سردی لحیم آی‌سی‌ها، تست و کنترل کیفیت پس از ریبال، مناسب انواع تلویزیون‌های LED، LCD و هوشمند.</p>

        </div>
        <div class="experience1 elevated">
            <img src="~/images/Bonding.png" alt="خدمات بندینگ فلت تلویزیون در مشهد" />
            <h4 style="color:#1d0c75">بندینگ</h4>
            <div class="divider"></div>
            <p>رفع خطوط روی تصویر تلویزیون، تعمیر و باندینگ فلت پنل LED و LCD، ترمیم اتصالات COF و TAB، رفع مشکلات ناشی از قطعی فلت پنل، کاهش هزینه تعمیر نسبت به تعویض پنل، انجام تعمیرات با دستگاه‌های تخصصی باندینگ.</p>

        </div>
    </div>
</div>

<div class="subhero2">
    <h2>محصولات فروشگاه سلیمی</h2>
    <div class="divider"></div>

    <div class="products-container elevated">
        <div class="products-track ">

            @foreach (var item in Model.Products)
            {
                <div class="product-card">
                    <div class="product-image">
                        <img src="~/images//products/@item.ImgUrl" alt="">
                        <span class="badge-discount">15٪</span>
                    </div>

                    <h3 class="product-title">@item.Title</h3>

                    <div class="product-price">
                        <span class="old-price">@item.Price</span>
                        <span class="new-price">@item.DiscountPrice تومان</span>
                    </div>

                    <button class="btn-buy">مشاهده محصول</button>
                </div>
            }

        </div>
    </div>

</div>

<div class="subhero3">
    <div class="honors-header">
        <h2>نمایندگی ها</h2>
        <span>Representations</span>
    </div>

    <div class="honors-grid">

        <div class="honor-item" style="border-right:none;"><img src="~/images/sony.png" alt="تعمیر تلویزیون سونی در مشهد"></div>
        <div class="honor-item"><img src="~/images/lg.png" alt="تعمیر تلویزیون ال جی در مشهد"></div>
        <div class="honor-item"><img src="~/images/samsung.png" alt="تعمیر تلویزیون سامسونگ در مشهد"></div>
        <div class="honor-item"><img src="~/images/tcl.png" alt="تعمیر تلویزیون تی سی ال در مشهد"></div>
        <div class="honor-item"><img src="~/images/daewoo.png" alt="تعمیر تلویزیون دوو در مشهد"></div>

        <div class="honor-item" style="border-right:none; border-bottom:none;"><img src="~/images/gplus.png" alt="تعمیر تلویزیون جی پلاس در مشهد"></div>
        <div class="honor-item" style="border-bottom:none;"><img src="~/images/hisense.png" alt="تعمیر تلویزیون هایسنس در مشهد"></div>
        <div class="honor-item" style="border-bottom:none;"><img src="~/images/snowa.png" alt="تعمیر تلویزیون اسنوا در مشهد"></div>
        <div class="honor-item" style="border-bottom:none;"><img src="~/images/xvision.png" alt="تعمیر تلویزیون ایکس ویژن در مشهد"></div>
        <div class="honor-item" style="border-bottom:none;"><img src="~/images/sam.png" alt="تعمیر تلویزیون سام در مشهد"></div>

    </div>
</div>

<div class="subhero4">
    <div class="info">
        <h2>نظرات شما</h2>
        <p>
            تیم مهندسی سلیمی با بیش از 35 سال سابقه در زمینه تعمیر تلویزیون در مشهد،
            خدمات تخصصی تعمیر تلویزیون ال جی، سامسونگ، سونی، TCL،
            اسنوا، ایکس ویژن و سایر برندها را ارائه می‌دهد.
        </p>
        <p>
            خدمات ما شامل تعمیر بک لایت، تعمیر برد پاور،
            تعمیر مین برد، تعمیر پنل و بندینگ تلویزیون در مشهد می‌باشد.
        </p>
        <p>وقتی شما نظر می‌دهید:</p>
        <ul>
            <li>ما نقاط ضعف کارمان را دقیق‌تر می‌بینیم.</li>
            <li>کیفیت خدمات‌مان را ارتقا می‌دهیم.</li>
            <li>سرعت، دقت و رضایت شما را بیشتر می‌کنیم.</li>
            <li>به دیگران کمک می‌کنید با اطمینان ما را انتخاب کنند.</li>
        </ul>
        <p>هر پیامی که از شما دریافت می‌کنیم — چه پیشنهاد، چه انتقاد، چه رضایت — مستقیماً در بهبود فرآیندهای فنی و خدماتی ما اثر دارد.</p>
        <p>
            اگر از خدمات ما استفاده کرده‌اید، لطفاً تجربه‌تان را با ما و دیگران به اشتراک بگذارید.
            صدای شما، سرمایه واقعی تیم مهندسی سلیمی است.
        </p>
    </div>
    <form class="comments-container elevated" method="post" asp-action="Index" asp-controller="Home">
        <div asp-validation-summary="All"></div>
        <h2>نظرات خود را بنویسید</h2>
        <input type="text" asp-for="CreateComment.FullName" placeholder="نام و نام خانوادگی شما">
        <input type="text" asp-for="CreateComment.Phone" placeholder="شماره تماس">
        <textarea asp-for="CreateComment.Description" placeholder="نظر خود را بنویسید..."></textarea>
        <div class="rating">
            <div class="stars" id="starRating">
                <i class="fa-regular fa-star" data-value="1"></i>
                <i class="fa-regular fa-star" data-value="2"></i>
                <i class="fa-regular fa-star" data-value="3"></i>
                <i class="fa-regular fa-star" data-value="4"></i>
                <i class="fa-regular fa-star" data-value="5"></i>
            </div>

            <!-- مقدار انتخاب‌شده برای ارسال به بک‌اند -->
            <input type="hidden" id="rateValue" value="0" asp-for="CreateComment.Rate">
        </div>

        <button type="submit" class="Btn">ثبت نظرات</button>
    </form>
</div>
<div class="subhero5">
    <h2>نظرات شما</h2>
    <div class="divider"></div>

    <div class="swiper commentsSwiper">
        <div class="swiper-wrapper">

            @foreach (var item in Model.Comments)
            {
                <div class="swiper-slide">
                    <div class="comment-card elevated">
                        <div class="comment-header">
                            @{
                                string avatar = item.FullName[0].ToString();
                            }
                            <div class="avatar">@avatar</div>
                            <div>
                                <div class="name">@item.FullName</div>
                                <div class="stars">
                                    @for (int i = 0; i < item.Rate; i++)
                                    {
                                        <text>★</text>

                                    }
                                </div>
                            </div>
                        </div>
                        <p>
                            @item.Description
                        </p>
                    </div>
                </div>
            }

            <div class="swiper-slide">
                <div class="comment-card elevated">
                    <div class="comment-header">
                        <div class="avatar">م</div>
                        <div>
                            <div class="name">مریم احمدی</div>
                            <div class="stars">★★★★★</div>
                        </div>
                    </div>
                    <p>
                        قبلاً جای دیگه برده بودم گفتن پنل سوخته! اینجا با هزینه خیلی کمتر درستش کردن.
                        انصاف و تخصص رو با هم دارن.
                    </p>
                </div>
            </div>

            <div class="swiper-slide">
                <div class="comment-card elevated">
                    <div class="comment-header">
                        <div class="avatar">ح</div>
                        <div>
                            <div class="name">حسین کاظمی</div>
                            <div class="stars">★★★★☆</div>
                        </div>
                    </div>
                    <p>
                        برای تعمیر پاور تلویزیون مراجعه کردم. برخورد عالی و توضیحات فنی کامل دادن.
                        قیمت هم منصفانه بود.
                    </p>
                </div>
            </div>

            <div class="swiper-slide">
                <div class="comment-card elevated">
                    <div class="comment-header">
                        <div class="avatar">ن</div>
                        <div>
                            <div class="name">نرگس محمدی</div>
                            <div class="stars">★★★★★</div>
                        </div>
                    </div>
                    <p>
                        خیلی خوش قول بودن. سر تایمی که گفتن تلویزیون رو تعمیر کردن.
                        عالی بود واقعاً.
                    </p>
                </div>
            </div>

            <div class="swiper-slide">
                <div class="comment-card elevated">
                    <div class="comment-header">
                        <div class="avatar">ر</div>
                        <div>
                            <div class="name">رضا کریمی</div>
                            <div class="stars">★★★★☆</div>
                        </div>
                    </div>
                    <p>
                        تصویر تلویزیون سایه داشت. فکر نمی‌کردم درست بشه ولی مثل روز اول شد.
                        کارشون بی‌نقصه.
                    </p>
                </div>
            </div>

            <div class="swiper-slide">
                <div class="comment-card elevated">
                    <div class="comment-header">
                        <div class="avatar">س</div>
                        <div>
                            <div class="name">سمیه رضوی</div>
                            <div class="stars">★★★★☆</div>
                        </div>
                    </div>
                    <p>
                        پاسخگویی سریع، پیگیری عالی و تعمیر کاملاً تخصصی.
                        حتماً پیشنهادشون می‌کنم.
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>
<div class="subhero6">
    <h2>مقالات</h2>
    <div class="divider"></div>

    <div class="Blog-Container">

        @foreach (var item in Model.Articles)
        {
            <div class="blog-item">
                <img src="~/images/@item.ImgUrl" alt="">
                <div class="blog-content">
                    <h4>@item.Title</h4>
                    <p>
                        @item.Description
                    </p>
                    <a asp-controller="Blog" asp-action="BlogPage" asp-route-id="@item.ArticleId" class="Btn">ادامه مطلب</a>
                </div>
            </div>

        }
        <div class="blog-item">
            <img src="~/images/tvNotTurnOn.jpg" alt="چرا تلویزیون زوشن نمی شود؟">
            <div class="blog-content">
                <h2>
                    علت روشن نشدن تلویزیون چیست؟ بررسی کامل دلایل و روش‌های رفع مشکل
                </h2>
                <a asp-controller="Blog" asp-action="PowerOffReason" class="Btn">ادامه مطلب</a>
            </div>
        </div>
        <div class="blog-item">
            <img src="~/images/BadFlat.jpg" alt="تلویزیون با پنل آسیب‌دیده و خطوط عمودی رنگی روی صفحه نمایش">
            <div class="blog-content">
                <h2>فلت تلویزیون چیست؟ علت خط دار شدن تصویر تلویزیون و روش‌های تعمیر آن</h2>
                <a asp-controller="Blog" asp-action="FlatBreak" class="Btn">ادامه مطلب</a>
            </div>
        </div>
        <div class="blog-item">
            <img src="~/images/PowerOff.jpg" alt="چرا تلویزیون روشن می‌شود اما تصویر بالا نمی‌آید؟ بررسی علت‌ها و راه‌حل‌ها">
            <div class="blog-content">
                <h2>چرا تلویزیون روشن می‌شود اما تصویر بالا نمی‌آید؟ بررسی علت‌ها و راه‌حل‌ها</h2>
                <a asp-controller="Blog" asp-action="PowerOff" class="Btn">ادامه مطلب</a>
            </div>
        </div>

        <div class="more-articles" style="display:block; width:100%;">
            <a asp-controller="Blog" asp-action="BlogMain" class="Btn">مشاهده مقالات بیشتر</a>
        </div>
    </div>
</div>

<script>
    const swiper = new Swiper(".commentsSwiper", {
        slidesPerView: 2,
        spaceBetween: 30,
        loop: true,
        autoplay: {
            delay: 5000,
            disableOnInteraction: false,
        },
        breakpoints: {
            0: { slidesPerView: 1 },
            768: { slidesPerView: 2 }
        }
    });
    const stars = document.querySelectorAll('#starRating i');
    const rateInput = document.getElementById('rateValue');

    stars.forEach(star => {
        star.addEventListener('mouseover', function () {
            const val = this.dataset.value;
            highlightStars(val);
        });

        star.addEventListener('mouseout', function () {
            highlightStars(rateInput.value);
        });

        star.addEventListener('click', function () {
            const val = this.dataset.value;
            rateInput.value = val;
            highlightStars(val);
        });
    });

    function highlightStars(count){
        stars.forEach(star => {
            star.classList.remove('active');
            if(star.dataset.value <= count){
                star.classList.add('active');
            }
        });
    }
</script>
