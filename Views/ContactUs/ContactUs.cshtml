@model TvRepairWebsite.Models.ViewModels.ContactUsVM;

<head>
    <link href="~/css/ContactUs.css" rel="stylesheet" />
</head>

<div class="banner diagonal-soft-bg" style="height:70vh;">
    <div class="banner-text">
        <h1>تیم مهندسی سلیمی</h1>
        <div class="divider"></div>
        <h2>۳۵ سال تجربه در کنار تخصص و سرعت</h2>
        <h3>با استفاده از قطعات اورجینال، کیفیت تصویر را به تلویزیون شما برمی‌گردانیم.</h3>
        <a href="tel:+989123456789" class="Btn num-subs">
            تماس بگیرید!
        </a>
    </div>
</div>
<section class="contact-us">
    <h2>تماس با ما</h2>
    <div class="divider"></div>
    <p>برای دریافت مشاوره یا خدمات تعمیر تلویزیون، با تیم متخصص <strong>تعمیرات تلویزیون سلیمی</strong> تماس بگیرید. ما آماده پاسخگویی به سوالات شما هستیم.</p>

    <div class="contact-info">
        <p>📞 تلفن: <a href="tel:+989154868011">09154868011</a></p>
        <p>📧 ایمیل: <a href="mailto:info@example.com">info@example.com</a></p>
        <p>📍 30 آدرس: استان خراسان رضوی، مشهد، خیابان سعدی، پاساژ بهزاد، طبقه دوم، واحد</p>
        <p>🕒 ساعات کاری: شنبه تا پنج شنبه ۹ صبح تا 9 شب</p>
    </div>

    <form action="#" method="post" class="contact-form">
        <div asp-validation-summary="All"></div>
        <input type="text" asp-for="FullName" placeholder="نام و نام خانوادگی" required>
        <span asp-validation-for="FullName"></span>
        <input type="text" asp-for="EmailOrPhone" placeholder="ایمیل یا شماره تماس" required>
        <span asp-validation-for="EmailOrPhone"></span>
        <input type="text" asp-for="Subject" placeholder="موضوع پیام" required>
        <span asp-validation-for="Subject"></span>
        <textarea asp-for="Message" placeholder="متن پیام خود را بنویسید..." required></textarea>
        <span asp-validation-for="Message"></span>
        <input  type="hidden" asp-for="CraeteDate"/>
        <button type="submit">ارسال پیام</button>
    </form>

    <p>همچنین می‌توانید از طریق <a href="https://wa.me/989154868011" target="_blank" rel="noopener">واتساپ</a> با ما در ارتباط باشید.</p>
</section>