@model IEnumerable<TvRepairWebsite.Models.Article>

@{
    ViewData["Title"] = "مقالات تخصصی تعمیرات تلویزیون";
}
<head>
    <link href="~/css/Blog.css
" rel="stylesheet" />
</head>
<section class="blogpage-hero  diagonal-soft-bg">
    <div class="blogpage-hero-content">
        <h1>مقالات تخصصی تعمیرات تلویزیون</h1>
        <p>آموزش‌ها، نکات فنی و راهنمای عیب‌یابی توسط تیم مهندسی سلیمی</p>
    </div>
</section>

<div class="subhero6" style="">


    <div class="Blog-Container">

        @foreach(var item in Model)
        {
            <div class="blog-item">
                <img src="~/images/@item.ImgUrl" alt="">
                <div class="blog-content">
                    <h4>@item.Title</h4>
                    <p>
                        @item.Description
                    </p>
                    <a asp-controller="Blog" asp-action="BlogPage" asp-route-id = "@item.ArticleId" class="Btn">ادامه مطلب</a>
                </div>
            </div>

        }

        <div class="blog-item">
            <img src="~/images/tvNotTurnOn.jpg" alt="چرا تلویزیون زوشن نمی شود؟">
            <div class="blog-content">
                <h2>
                    علت روشن نشدن تلویزیون چیست؟ بررسی کامل دلایل و روش‌های رفع مشکل
                </h2>
                <a asp-controller="Blog" asp-action="PowerOffReason" class="Btn">ادامه مطلب</a>
            </div>
        </div>
        <div class="blog-item">
            <img src="~/images/SuddenTvOff.jpg" alt="علت خاموش شدن ناگهانی تلویزیون چیست؟">
            <div class="blog-content">
                <h2>
                    علت خاموش شدن ناگهانی تلویزیون چیست؟ بررسی کامل دلایل و روش‌های رفع مشکل
                </h2>
                <a asp-controller="Blog" asp-action="SuddenTvOff" class="Btn">ادامه مطلب</a>
            </div>
        </div>

        <div class="blog-item">
            <img src="~/images/BadFlat.jpg" alt="تلویزیون با پنل آسیب‌دیده و خطوط عمودی رنگی روی صفحه نمایش">
            <div class="blog-content">
                <h2>فلت تلویزیون چیست؟ علت خط دار شدن تصویر تلویزیون و روش‌های تعمیر آن</h2>
                <a asp-controller="Blog" asp-action="FlatBreak" class="Btn">ادامه مطلب</a>
            </div>
        </div>
        <div class="blog-item">
            <img src="~/images/PowerOff.jpg" alt="چرا تلویزیون روشن می‌شود اما تصویر بالا نمی‌آید؟ بررسی علت‌ها و راه‌حل‌ها">
            <div class="blog-content">
                <h2>چرا تلویزیون روشن می‌شود اما تصویر بالا نمی‌آید؟ بررسی علت‌ها و راه‌حل‌ها</h2>
                <a asp-controller="Blog" asp-action="PowerOff" class="Btn">ادامه مطلب</a>
            </div>
        </div>
        <div class="blog-item">
            <img src="~/images/Water.jpg" alt="آب خوردگی تلویزیون؛ بعد از ریختن آب روی تلویزیون چه کارهایی باید انجام دهیم؟">
            <div class="blog-content">
                <h2>آب خوردگی تلویزیون؛ بعد از ریختن آب روی تلویزیون چه کارهایی باید انجام دهیم؟</h2>
                <a asp-controller="Blog" asp-action="Water" class="Btn">ادامه مطلب</a>
            </div>
        </div>
        <div class="blog-item">
            <img src="~/images/power-binking.jpg" alt="علت چشمک زدن چراغ پاور تلویزیون چیست؟ بررسی دلایل و روش‌های رفع مشکل">
            <div class="blog-content">
                <h2>
                    علت چشمک زدن چراغ پاور تلویزیون چیست؟ بررسی دلایل و روش‌های رفع مشکل
                </h2>
                <a asp-controller="Blog" asp-action="PowerLight" class="Btn">ادامه مطلب</a>
            </div>
        </div>
        <div class="blog-item">
            <img src="~/images/TvDimScreen.jpg" alt="صفحه تاریک تلویزیون، بک لایت، تاری صفحه تلویزیون، نور کم صفحه">
            <div class="blog-content">
                <h2>
                    علت کم شدن نور تلویزیون چیست؟ بررسی دلایل و روش‌های رفع مشکل
                </h2>
                <a asp-controller="Blog" asp-action="TvDimScreen" class="Btn">ادامه مطلب</a>
            </div>
        </div>
        <div class="blog-item">
            <img src="~/images/NoPicture.webp" alt="تلویزیون صدا دارد ولی تصویر ندارد" />
            <div class="blog-content">
                <h2>
                    تلویزیون صدا دارد ولی تصویر ندارد؛ علت چیست و چگونه مشکل را برطرف کنیم؟
                </h2>
                <a asp-controller="Blog" asp-action="TVNoPicture" class="Btn">ادامه مطلب</a>
            </div>
        </div>
    </div>
</div>

