@model TvRepairWebsite.Models.Article

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/css/BlogPro.css" rel="stylesheet" />
}

@section Meta {
    <title>@Model.Title</title>
    <meta name="description" content="@Model.Meta_Description">
    <meta name="keywords" content="تعمیر تلویزیون, مقالات آموزشی" />
    <link rel="canonical" href="https://salimivision.ir/Blog/@Model.ArticleAddress" />

    <!-- Schema.org Article -->
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "Article",
          "headline": "@Model.Title",
          "description": "@Model.Meta_Description",
          "datePublished": "@Model.CreateDate.ToString("yyyy-MM-dd")",
          "author": {
            "@@type": "Organization",
            "name": "تعمیرات تلویزیون سلیمی"
          },
          "publisher": {
            "@@type": "Organization",
            "name": "تعمیرات تلویزیون سلیمی",
            "logo": {
              "@@type": "ImageObject",
              "url": "https://salimivision.ir/images/logo.png"
            }
          },
          "mainEntityOfPage": {
            "@@type": "WebPage",
            "@@id": "https://salimivision.ir/Blog/@Model.ArticleAddress"
          }
        }
    </script>

    <!-- Schema.org Breadcrumb -->
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "name": "خانه",
              "item": "https://salimivision.ir/"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "name": "وبلاگ",
              "item": "https://salimivision.ir/Blog"
            },
            {
              "@@type": "ListItem",
              "position": 3,
              "name": "@Model.Title",
              "item": "https://salimivision.ir/Blog/@Model.ArticleAddress"
            }
          ]
        }
    </script>

    @if (Model.ArticleQuestions != null && Model.ArticleQuestions.Any())
    {
        // ساخت پویا اسکیمای سوالات متداول بر اساس سوالات دیتابیس
        <script type="application/ld+json">
            {
              "@@context": "https://schema.org",
              "@@type": "FAQPage",
              "mainEntity": [
                @for (int i = 0; i < Model.ArticleQuestions.Count; i++)
                {
                        var faq = Model.ArticleQuestions[i];
                        @:{"@@type": "Question", "name": "@faq.Question", "acceptedAnswer": {"@@type": "Answer", "text": "@faq.Awnser"}}@(i < Model.ArticleQuestions.Count - 1 ? "," : "")
                }
              ]
            }
        </script>
    }

    <style>
        .article-hero {
            background: linear-gradient(135deg,#0f172a,#1e293b);
            color: #ffff;
            padding: 60px 0;
        }

            .article-hero img {
                width: 100%;
                max-height: 300px;
                object-fit: cover;
                border-radius: 20px;
            }

        .article-title {
            margin-top: 20px;
            font-size: 30px;
            font-weight: 800;
        }

        .article-desc {
            opacity: .85;
            margin-top: 15px;
            font-size: 15px;
            line-height: 1.8;
        }

        .article-badges span {
            display: inline-block;
            background: rgba(255,255,255,0.15);
            padding: 5px 12px;
            margin: 5px 5px 5px 0;
            border-radius: 20px;
            font-size: 12px;
        }

        .toc {
            position: sticky;
            top: 20px;
            background: #f8f9fa;
            padding: 15px;
            border-radius: 10px;
        }

        .article-content {
            line-height: 2.1;
            font-size: 16px;
        }

        .trust-box {
            margin-top: 40px;
            background: #f1f5f9;
            padding: 20px;
            border-radius: 12px;
        }

        .trust-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 10px;
        }

        .mid-cta {
            background: #111827;
            color: #fff;
            padding: 25px;
            border-radius: 12px;
            text-align: center;
            margin: 40px 0;
        }

        .final-cta {
            text-align: center;
            margin-top: 50px;
        }

        .accordion-button {
            font-size: 15px !important;
            text-align: right !important;
        }

        .accordion-body {
            font-size: 14px !important;
            line-height: 1.8;
        }
    </style>
}

<!-- HERO -->
<section class="article-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="article-title">@Model.Title</h1>
                <div class="article-desc">
                    @Html.Raw(Model.Little_Description)
                </div>
                <div class="article-badges mt-3">
                    <span>تعمیر تخصصی</span>
                    <span>خدمات در محل</span>
                    <span>گارانتی خدمات</span>
                    <span>تاریخ انتشار: @Model.CreateDate</span> <!-- اگر هلپر شمسی دارید -->
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-block text-center">
                <img src="~/images/@Model.ImgUrl" alt="@Model.Title" />
            </div>
        </div>
    </div>
</section>

<!-- CONTENT AREA -->
<section class="article-body container" style="margin-top:3%;">
    <div class="row">

        <!-- TOC (فهرست) -->
        <aside class="col-lg-3 d-none d-lg-block">
            <div class="toc">
                <h6>فهرست محتوا</h6>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><a href="#intro" class="text-decoration-none">مقدمه</a></li>
                    <li class="mb-2"><a href="#content" class="text-decoration-none">متن اصلی</a></li>
                    <li class="mb-2"><a href="#conclusion" class="text-decoration-none">جمع‌بندی</a></li>
                    <li class="mb-2"><a href="#trust" class="text-decoration-none">چرا ما؟</a></li>
                    @if (Model.ArticleQuestions != null && Model.ArticleQuestions.Any())
                    {
                        <li><a href="#faq" class="text-decoration-none">سوالات متداول</a></li>
                    }
                </ul>
            </div>
        </aside>

        <!-- MAIN -->
        <div class="col-lg-9">

            <!-- INTRO -->
            <section id="intro" class="mb-5">
                <h3 class="fw-bold mb-3">مقدمه</h3>
                <div class="article-content">
                    @Html.Raw(Model.Introduction)
                </div>
            </section>

            <!-- ARTICLE CONTENT -->
            <section id="content" class="article-content mb-5">
                <h3 class="fw-bold mb-3">جزئیات مقاله</h3>
                @Html.Raw(Model.Body)
            </section>

            <!-- CONCLUSION -->
            <section id="conclusion" class="article-content mb-5">
                <h3 class="fw-bold mb-3">جمع‌بندی</h3>
                @Html.Raw(Model.Conclusion)
            </section>

            <!-- TRUST SECTION -->
            <section id="trust" class="trust-box mb-5">
                <h3 class="h5 fw-bold">چرا تعمیرات تلویزیون سلیمی؟</h3>
                <div class="trust-grid">
                    <div>✔ تعمیر تخصصی انواع تلویزیون</div>
                    <div>✔ اعزام سریع تعمیرکار</div>
                    <div>✔ قیمت منصفانه</div>
                    <div>✔ ضمانت خدمات</div>
                </div>
            </section>

            <!-- CTA MID -->
            <div class="mid-cta">
                <h4>اگر مشکل تلویزیون دارید</h4>
                <p class="mb-3">همین الان تماس بگیرید تا کارشناسان راهنمایی کنند</p>
                <a href="tel:09154868011" class="btn btn-success px-4 py-2">
                    تماس فوری
                </a>
            </div>

            <!-- FAQ (نمایش پویا سوالات متداول از دیتابیس) -->
            @if (Model.ArticleQuestions != null && Model.ArticleQuestions.Any())
            {
                <section id="faq" class="faq-section mb-5">
                    <h3 class="fw-bold mb-3">سوالات متداول</h3>
                    <div class="accordion" id="faqAcc">
                        @for (int i = 0; i < Model.ArticleQuestions.Count; i++)
                        {
                            var faq = Model.ArticleQuestions[i];
                            string collapseId = $"faqCollapse{i}";
                            string headerId = $"faqHeader{i}";

                            <div class="accordion-item">
                                <h2 class="accordion-header" id="@headerId">
                                    <button class="accordion-button @(i > 0 ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="@collapseId">
                                        @faq.Question
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse @(i == 0 ? "show" : "")" aria-labelledby="@headerId" data-bs-parent="#faqAcc">
                                    <div class="accordion-body">
                                        @faq.Awnser
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- FINAL CTA -->
            <section class="final-cta p-4 bg-light rounded border">
                <h3 class="h5 fw-bold">نیاز به تعمیر فوری دارید؟</h3>
                <p class="text-muted mt-2">
                    تعمیرات تخصصی در <strong>تیم مهندسی سلیمی تعمیرات</strong> با بررسی دقیق و عیب‌یابی حرفه‌ای انجام می‌شود.
                    برای دریافت مشاوره یا ثبت درخواست تعمیر می‌توانید با
                    <a href="tel:09154868011" class="text-primary fw-bold">این شماره</a>
                    تماس بگیرید.
                </p>
            </section>

        </div>
    </div>
</section>
