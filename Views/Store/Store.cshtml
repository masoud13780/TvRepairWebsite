                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="G+" asp-route-part="@Context.Request.Query["brand"]">Hardstone</a></li>
                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="G+" asp-route-part="@Context.Request.Query["brand"]">Univa</a></li>
                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="G+" asp-route-part="@Context.Request.Query["brand"]">Awox</a></li>
                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="G+" asp-route-part="@Context.Request.Query["brand"]">Axun</a></li>
                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="G+" asp-route-part="@Context.Request.Query["brand"]">Media star</a></li>
                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="G+" asp-route-part="@Context.Request.Query["brand"]">star sat</a></li>
                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="G+" asp-route-part="@Context.Request.Query["brand"]">Hyundai</a></li>
                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="G+" asp-route-part="@Context.Request.Query["brand"]">Blest</a></li>
                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="G+" asp-route-part="@Context.Request.Query["brand"]">Boost</a></li>
                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="G+" asp-route-part="@Context.Request.Query["brand"]">Tooshiba</a></li>
                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="G+" asp-route-part="@Context.Request.Query["brand"]">Panaromic</a></li>
