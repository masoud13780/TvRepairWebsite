@model IEnumerable<TvRepairWebsite.Models.Product>


<head>
    <link href="~/css/store.css" rel="stylesheet" />
</head>
<section class="banner  diagonal-soft-bg">
    <div class="banner-text">
        <h1>فروشگاه تخصصی سلیمی</h1>
        <div class="divider"></div>
        <p>فروش بردهای تخصصی برندهای مختلف تلویزیون‌ها</p>
    </div>
</section>

<div class="subhero2">

