                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="G+" asp-route-part="@Context.Request.Query["brand"]">Benq</a></li>
                </ul>

            </div>
            <div class="brands elevated">
                <h3>نوع قطعه</h3>
                <div class="divider"></div>
                <ul>
                    <li>
                        <a asp-action="Store"
                               asp-controller="Store"
                               asp-route-part="مین برد"
                               asp-route-brand='@Context.Request.Query["part"]'>
                            مین برد
                        </a>
                    </li>
                    <li>
                        <a asp-action="Store"
                               asp-controller="Store"
                               asp-route-part="برد تغذیه"
                               asp-route-brand="@Context.Request.Query["part"]">
                            برد تغذیه
                        </a>
                    </li>
                    <li>
                        <a asp-action="Store"
                               asp-controller="Store"
                               asp-route-part="بک لایت"
                               asp-route-brand="@Context.Request.Query["part"]">
                            بک لایت
                        </a>
                    </li>
                    <li>
                        <a asp-action="Store"
                               asp-route-part="قاب و بدنه"
                               asp-route-brand="@Context.Request.Query["part"]">
                            قاب و بدنه
                        </a>
                    </li>
                    <li>
                        <a asp-action="Store"
                               asp-route-part="پایه‌ها"
                               asp-route-brand="@Context.Request.Query["part"]">
                            پایه‌ها
                        </a>
                    </li>
                    <li>
                        <a asp-action="Store"
                               asp-route-part="سیستم صوتی"
                               asp-route-brand="@Context.Request.Query["part"]">
                            سیستم صوتی
                        </a>
                    </li>
                    <li>
                        <a asp-action="Store"
                               asp-route-part="پنل"
                               asp-route-brand="@Context.Request.Query["part"]">
                            پنل
                        </a>
                    </li>
                    <li>
                        <a asp-action="Store"
                               asp-route-part="برد اینورتر"
                               asp-route-brand="@Context.Request.Query["part"]">
                            برد اینورتر
                        </a>
                    </li>
                    <li>
                        <a asp-action="Store"
                               asp-route-part="آی سی‌ها"
                               asp-route-brand="@Context.Request.Query["part"]">
                            آی سی‌ها
                        </a>
                    </li>
                    <li>
                        <a asp-action="Store"
                               asp-route-part="برنامه‌های فلش"
                               asp-route-brand="@Context.Request.Query["part"]">
                            برنامه‌های فلش
                        </a>
                    </li>
                    <li>
                        <a asp-action="Store"
                               asp-route-part="سنسورها"
                               asp-route-brand="@Context.Request.Query["part"]">
                            سنسورها
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="products-track" style="width:70%; flex-wrap:wrap">


            @foreach (var item in Model)
            {
                <div class="product-card">
                    <div class="product-image">
                        <img src="~/images/products/@item.ImgUrl" alt="">
                    </div>

                    <h3 class="product-title">@item.Title</h3>

                    <div class="product-price">
                        <span class="old-price">@(item.Price != null ? item.Price.ToString() : "")</span>
                        <span class="new-price">@item.DiscountPrice تومان</span>
                    </div>

                    <button class="btn-buy">مشاهده محصول</button>
                </div>

            }

        </div>
    </div>

</div>