                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="Sam" asp-route-part="@Context.Request.Query["brand"]">Sam</a></li>
                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="sharp" asp-route-part="@Context.Request.Query["brand"]">sharp</a></li>
                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="shahb" asp-route-part="@Context.Request.Query["brand"]">shahb</a></li>
