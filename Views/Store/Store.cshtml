                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="hisense" asp-route-part="@Context.Request.Query["brand"]">hisense</a></li>
                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="daewoo" asp-route-part="@Context.Request.Query["brand"]">daewoo</a></li>
                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="G+" asp-route-part="@Context.Request.Query["brand"]">G+</a></li>
                    <li><a asp-action="Store" asp-controller="Store" asp-route-brand="G+" asp-route-part="@Context.Request.Query["brand"]">Aiwa</a></li>
