@model IEnumerable<Article>

<div class="content">

    <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2>مدیریت مقالات</h2>
        <button class="btn btn-success" onclick="openArticleModal()">افزودن مقاله</button>
    </div>

    <table class="table" id="articleTable">
        <thead>
            <tr>
                <th>عنوان</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>
                        <button class="btn btn-danger deleteBtn" data-id="@item.ArticleId">
                              
                            حذف
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>


</div>

<div class="modal-overlay" id="articleModal" style="display:none;">
    <div class="Modal">

        <h3>افزودن مقاله</h3>

        <form id="articleForm" enctype="multipart/form-data">

            <label>عکس مقاله</label>
            <input type="file" name="ImageFile" required />

            <label>عنوان مقاله</label>
            <input type="text" name="Title" required />

            <label>متن مقاله</label>
            <textarea name="Content" id="editor"></textarea>

            <div style="margin-top:20px;">
                <button type="submit" class="btn btn-success">ذخیره</button>
                <button type="button" class="btn btn-danger" onclick="closeArticleModal()">انصراف</button>
            </div>

        </form>

    </div>
</div>
<script>
    CKEDITOR.replace('editor');

    document.getElementById("articleForm")
        .addEventListener("submit", function (e) {

            e.preventDefault();

            // چون CKEditor داری
            for (instance in CKEDITOR.instances) {
                CKEDITOR.instances[instance].updateElement();
            }

            var formData = new FormData(this);

            fetch('/Admin/ArticleCreate', {
                method: 'POST',
                body: formData
            })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    } else {
                        alert("خطا در ذخیره مقاله");
                    }
                });
        });


    var articleModal = document.getElementById("articleModal");

    function openArticleModal() {
        articleModal.style.display = "flex";
    }

    function closeArticleModal() {
        articleModal.style.display = "none";
    }

    articleModal.addEventListener("click", function(e) {
        if (e.target === articleModal) {
            closeArticleModal();
        }
    });

    document.querySelectorAll(".deleteBtn").forEach(btn => {
        btn.addEventListener("click", function () {
            const id = this.dataset.id;
            if (!confirm("آیا از حذف مقاله مطمئن هستید؟")) return;
            deleteArticle(id);
        });
    });

    // function deleteArticle(id) {
    //     fetch('/Admin/ArticleDelete', {
    //         method: 'POST',
    //         headers: { 'Content-Type': 'application/json' },
    //         body: JSON.stringify({ id: id })
    //     })
    //         .then(response => {
    //             if (response.ok) location.reload();
    //             else alert("خطا در حذف مقاله");
    //         });
    // }

    function deleteArticle(id) {

        if (!confirm("آیا از حذف این محصول مطمئن هستید؟"))
            return;

        fetch(`/Admin/ArticleDelete?id=${id}`, {
            method: 'POST'
        })
            .then(res => res.json())
            .then(data => {

                if (data.success) {
                    location.reload();
                }
                else {
                    alert(data.message || "خطا در حذف");
                }

            })
            .catch(err => {
                console.error(err);
                alert("خطای سیستمی رخ داده است");
            });
    }

</script>
