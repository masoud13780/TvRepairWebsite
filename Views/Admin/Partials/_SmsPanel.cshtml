<div class="content">

    <h2>تنظیمات پیامک</h2>

    <div class="card">

        <label>متن پیامک پیش‌فرض</label>

        <textarea id="smsTemplate"
                  style="width:100%; height:180px; margin-top:10px;">
سلام {نام} عزیز،
ثبت نام شما با موفقیت انجام شد.
        </textarea>

        <div style="margin-top:15px;">
            <button class="btn btn-success" onclick="saveSmsTemplate()">
                ذخیره تغییرات
            </button>
        </div>

    </div>

</div>
<script>

    function saveSmsTemplate() {

        const content = document.getElementById("smsTemplate").value;

        if (!content.trim()) {
            alert("متن پیامک نمی‌تواند خالی باشد.");
            return;
        }

        // اینجا Ajax به سرور بزن
        console.log("Saving SMS template:", content);

        alert("متن پیامک با موفقیت ذخیره شد.");
    }

</script>
