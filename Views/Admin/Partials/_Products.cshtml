<head>
    <link href="~/css/Admin.css" rel="stylesheet" />
</head>
<div class="content">

    <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2>مدیریت محصولات</h2>
        <button class="btn btn-success" onclick="openAddModal()">افزودن محصول</button>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th> نام قطعه</th>
                <th>قیمت فعلی</th>
                <th>برند</th>
                <th>نوع قطعه</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td>
                    <button class="btn btn-primary"
                            onclick="openEditModal()">
                        ویرایش
                    </button>

                    <button class="btn btn-danger"
                            onclick="deleteProduct()">
                        حذف
                    </button>
                </td>
            </tr>
        </tbody>
    </table>

</div>


<div class="modal-overlay" id="productModal" style="display:none;">
    <div class="Modal">
        <h3 id="modalTitle">افزودن محصول</h3>

        <form id="productForm" enctype="multipart/form-data">

            <input type="hidden" id="ProductId" name="Id" />

            <label>عکس محصول</label>
            <input type="file" name="ImageFile" />

            <label>نام محصول</label>
            <input type="text" name="Title" id="Title" required />

            <label>توضیحات</label>
            <textarea name="Description" id="Description"></textarea>

            <label>قیمت قبلی</label>
            <input type="number" name="OldPrice" id="OldPrice" />

            <label>قیمت فعلی</label>
            <input type="number" name="Price" id="Price" required />

            <label>برند</label>
            <select name="Brand" id="Brand">
                <option>Sony</option>
                <option>Samsung</option>
                <option>lg</option>
                <option>Tcl</option>
                <option>panasonic</option>
                <option>sam</option>
                <option>sharp</option>
                <option>shahb</option>
                <option>xvision</option>
                <option>snowa</option>
                <option>hisense</option>
                <option>daewoo</option>
                <option>G+</option>
            </select>

            <label>نوع قطعه</label>
            <select name="PartType" id="PartType">
                <option>مین برد</option>
                <option>برد تغذیه</option>
                <option>بک لایت</option>
                <option>قاب و بدنه</option>
                <option>پایه‌ها</option>
                <option>سیستم صوتی</option>
                <option>پنل</option>
                <option>برد اینورتر</option>
                <option>آی سی‌ها</option>
                <option>برنامه‌های فلش</option>
                <option>سنسورها</option>
            </select>

            <div style="margin-top:15px;">
                <button type="submit" class="btn btn-success">ذخیره</button>
                <button type="button" class="btn btn-danger" onclick="closeModal()">انصراف</button>
            </div>

        </form>
    </div>
</div>

<script>

    const overlay = document.getElementById("productModal");
    const modalTitle = document.getElementById("modalTitle");
    const form = document.getElementById("productForm");

    // ===============================
    // باز کردن مودال افزودن
    // ===============================
    function openAddModal() {

        form.reset(); // خالی کردن فرم
        document.getElementById("ProductId").value = "";

        modalTitle.innerText = "افزودن محصول";

        overlay.style.display = "flex";
    }


    // ===============================
    // باز کردن مودال ویرایش
    // ===============================
    function openEditModal() {

        modalTitle.innerText = "ویرایش محصول";

        overlay.style.display = "flex";
    }


    // ===============================
    // بستن مودال
    // ===============================
    function closeModal() {
        overlay.style.display = "none";
    }


    // ===============================
    // بستن با کلیک خارج از مودال
    // ===============================
    overlay.addEventListener("click", function (e) {
        if (e.target === overlay) {
            closeModal();
        }
    });


    // ===============================
    // حذف محصول
    // ===============================
    function deleteProduct(id) {

        const confirmDelete = confirm("آیا از حذف این محصول مطمئن هستید؟");

        if (!confirmDelete) return;

        // اینجا بعدا Ajax میزنی
        console.log("Deleting product id:", id);

        // فعلا فقط پیام
        alert("محصول حذف شد (نمونه تست)");
    }

</script>
