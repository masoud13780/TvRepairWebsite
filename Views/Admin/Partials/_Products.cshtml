@model TvRepairWebsite.Models.ViewModels.ProductAdminVM;

<head>
    <link href="~/css/Admin.css" rel="stylesheet" />
</head>
<div class="content">

    <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2>مدیریت محصولات</h2>
        <button class="btn btn-success" onclick="openAddModal()">افزودن محصول</button>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th> نام قطعه</th>
                <th>قیمت فعلی</th>
                <th>برند</th>
                <th>نوع قطعه</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Products)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Price</td>
                    <td>@item.Category.CategoryName</td>
                    <td>@item.Part.PartName</td>
                    <td>
                        <button class="btn btn-primary"
                                onclick="openEditModal(
                                        @item.ProductId,
                                       '@item.Title',
                                       '@item.Description',
                                        @item.DiscountPrice,
                                        @item.Price,
                                        '@item.CategoryId',
                                        '@item.PartId',
                                         '@item.ImgUrl'
                                    )">
                            ویرایش
                        </button>

                        <button class="btn btn-danger"
                                onclick="deleteProduct(@item.ProductId)">
                            حذف
                        </button>
                    </td>
                </tr>

            }
        </tbody>
    </table>

</div>


<div class="modal-overlay" id="productModal" style="display:none;">
    <div class="Modal">
        <h3 id="modalTitle">افزودن محصول</h3>

        <form id="productForm" enctype="multipart/form-data">

            <input type="hidden" id="ProductId" name="ProductId" />
            <input type="hidden" id="ExistingImage" name="ExistingImage" />

            <label>عکس محصول</label>
            <input type="file" name="ImgUrl" id="currentImage" />

            <label>نام محصول</label>
            <input type="text" name="Title" id="Title" required />

            <label>توضیحات</label>
            <textarea name="Description" id="Description"></textarea>

            <label>قیمت قبلی</label>
            <input type="text" name="discountPrice" id="OldPrice" />

            <label>قیمت فعلی</label>
            <input type="text" name="Price" id="Price" required />

            <label>برند</label>
            <select name="CategoryId" id="Brand">
                @foreach (var item in Model.Categories)
                {
                    <option value="@item.CategoryId">@item.CategoryName</option>
                }
            </select>

            <label>نوع قطعه</label>
            <select name="PartId" id="PartType">
                @foreach (var item in Model.Parts)
                {
                    <option value="@item.PartId">@item.PartName</option>
                }
            </select>

            <div style="margin-top:15px;">
                <button type="submit" class="btn btn-success">ذخیره</button>
                <button type="button" class="btn btn-danger" onclick="closeModal()">انصراف</button>
            </div>

        </form>
    </div>
</div>

<script>

    var overlay1 = document.getElementById("productModal");
    var productmodalTitle = document.getElementById("modalTitle");
    var productform = document.getElementById("productForm");

    // =========================================
    // ثبت فرم (افزودن / ویرایش)
    // =========================================
    productform.addEventListener("submit", function (e) {

        e.preventDefault();

        const formData = new FormData(productform);
        const id = document.getElementById("ProductId").value;

        const url = id
            ? '/Admin/EditProduct'
            : '/Admin/AddProduct';

        fetch(url, {
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(data => {

                if (data.success) {
                    location.reload();
                }
                else {
                    alert(data.message || "خطا در ذخیره اطلاعات");
                }

            })
            .catch(err => {
                console.error(err);
                alert("خطای سیستمی رخ داده است");
            });

    });


    // =========================================
    // باز کردن مودال افزودن
    // =========================================
    function openAddModal() {

        productform.reset();
        document.getElementById("ProductId").value = "";

        productmodalTitle.innerText = "افزودن محصول";
        overlay1.style.display = "flex";
    }


    // =========================================
    // باز کردن مودال ویرایش
    // =========================================
    function openEditModal(id, title, description, oldPrice, price, brand, partType, imgUrl) {
        document.getElementById("ProductId").value = id;
        document.getElementById("Title").value = title;
        document.getElementById("Description").value = description;
        document.getElementById("OldPrice").value = oldPrice;
        document.getElementById("Price").value = price;
        document.getElementById("Brand").value = brand;
        document.getElementById("PartType").value = partType;
        document.getElementById("ExistingImage").value = imgUrl;

        // نمایش تصویر قبلی
        // const currentImg = document.getElementById("currentImage");
        // if (currentImg) {
        //     currentImg.src = `/images/products/${imgUrl}`;
        // }

        productmodalTitle.innerText = "ویرایش محصول";
        overlay1.style.display = "flex";
    }


    // =========================================
    // بستن مودال
    // =========================================
    function closeModal() {
        overlay1.style.display = "none";
    }


    // =========================================
    // بستن با کلیک خارج از مودال
    // =========================================
    overlay1.addEventListener("click", function (e) {
        if (e.target === overlay1) {
            closeModal();
        }
    });


    // =========================================
    // حذف محصول
    // =========================================
    function deleteProduct(id) {

        if (!confirm("آیا از حذف این محصول مطمئن هستید؟"))
            return;

        fetch(`/Admin/DeleteProduct?id=${id}`, {
            method: 'POST'
        })
            .then(res => res.json())
            .then(data => {

                if (data.success) {
                    location.reload();
                }
                else {
                    alert(data.message || "خطا در حذف");
                }

            })
            .catch(err => {
                console.error(err);
                alert("خطای سیستمی رخ داده است");
            });
    }

</script>
